---
const lang = Astro.url.pathname.includes("/es") ? "es" : "en";
const base = import.meta.env.BASE_URL;
---

<section id="about" class="section-alt py-32 px-5">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-2 gap-16 items-center mb-20">
      <div class="reveal">
        <p class="font-mono text-[var(--color-accent)] text-sm mb-4 tracking-[0.3em] uppercase">// {lang === "es" ? "resultados" : "results"}</p>
        <h2 class="tracking-tight mb-6 leading-[0.95]" style="font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3.5rem);">
          {lang === "es"
            ? "Miniaturas que hacen crecer canales de Minecraft."
            : "Thumbnails that grow Minecraft channels."}
        </h2>
        <p class="muted leading-relaxed mb-6 text-lg">
          {lang === "es"
            ? "Diseñé miniaturas para canales de más de 200K subs y generé más de 100K vistas. Sin click, no hay video."
            : "Designed thumbnails for channels with 200K+ subs and generated over 100K views. No click, no video."}
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="tag px-3 py-1.5 rounded text-xs font-mono">Minecraft</span>
          <span class="tag px-3 py-1.5 rounded text-xs font-mono">YouTube</span>
          <span class="tag px-3 py-1.5 rounded text-xs font-mono">CTR</span>
          <span class="tag px-3 py-1.5 rounded text-xs font-mono">Photoshop</span>
        </div>
      </div>
      <div class="relative reveal" style="animation-delay:0.15s">
        <div class="card bg-[var(--color-surface-dark)] border border-[var(--color-border-dark)] rounded-lg overflow-hidden">
          <img src={`${base}thumbnails/miniatura de chifruit.jpg`} alt="Minecraft thumbnail" class="w-full aspect-video object-cover" />
        </div>
        <div class="absolute -bottom-4 -right-4 w-full h-full border-2 border-[var(--color-accent)]/20 rounded-lg -z-10"></div>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-[var(--color-border-dark)] rounded-lg overflow-hidden">
      <div class="reveal bg-[var(--color-bg-dark)] p-8 text-center" style="animation-delay:0s">
        <span class="block leading-none mb-2" style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4rem);">100K<span class="text-[var(--color-accent)]">+</span></span>
        <span class="muted text-sm block uppercase tracking-widest">{lang === "es" ? "vistas generadas" : "views generated"}</span>
      </div>
      <div class="reveal bg-[var(--color-bg-dark)] p-8 text-center" style="animation-delay:0.1s">
        <span class="block leading-none mb-2" style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4rem);">200K<span class="text-[var(--color-accent)]">+</span></span>
        <span class="muted text-sm block uppercase tracking-widest">{lang === "es" ? "subs alcanzados" : "subs reached"}</span>
      </div>
      <div class="reveal bg-[var(--color-bg-dark)] p-8 text-center col-span-2 md:col-span-1" style="animation-delay:0.2s">
        <span class="block leading-none mb-2" style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4rem);">6</span>
        <span class="muted text-sm block uppercase tracking-widest">thumbnails</span>
      </div>
    </div>
  </div>
</section>
