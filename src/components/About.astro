---
const lang = Astro.url.pathname.includes("/es") ? "es" : "en";
const base = import.meta.env.BASE_URL;
---

<section id="about" class="section-alt">
  <div class="grid md:grid-cols-2">
    <div class="relative md:sticky md:top-0 md:h-screen overflow-hidden">
      <img src={`${base}thumbnails/miniatura de chifruit.jpg`} alt="Minecraft thumbnail" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-[var(--color-bg-dark)] opacity-10"></div>
    </div>

    <div class="px-5 md:px-16 py-24 md:py-40 flex flex-col justify-center gap-24">
      <div class="reveal">
        <p class="font-mono text-[var(--color-accent)] text-sm mb-4 tracking-[0.3em] uppercase">// {lang === "es" ? "resultados" : "results"}</p>
        <h2 class="tracking-tight mb-6 leading-[0.95]" style="font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3.5rem);">
          {lang === "es"
            ? "Miniaturas que hacen crecer canales de Minecraft."
            : "Thumbnails that grow Minecraft channels."}
        </h2>
        <p class="muted leading-relaxed text-lg">
          {lang === "es"
            ? "Diseñé miniaturas para canales de más de 200K subs y generé más de 100K vistas. Sin click, no hay video."
            : "Designed thumbnails for channels with 200K+ subs and generated over 100K views. No click, no video."}
        </p>
      </div>

      <div class="reveal flex items-baseline gap-4">
        <span class="leading-none" style="font-family: var(--font-display); font-size: clamp(3.5rem, 8vw, 6rem);">100<span class="text-[var(--color-accent)]">K+</span></span>
        <span class="muted text-sm uppercase tracking-widest max-w-[8rem]">{lang === "es" ? "vistas generadas" : "views generated"}</span>
      </div>

      <div class="reveal flex items-baseline gap-4">
        <span class="leading-none" style="font-family: var(--font-display); font-size: clamp(3.5rem, 8vw, 6rem);">200<span class="text-[var(--color-accent)]">K+</span></span>
        <span class="muted text-sm uppercase tracking-widest max-w-[8rem]">{lang === "es" ? "subs alcanzados" : "subs reached"}</span>
      </div>

      <div class="reveal flex flex-wrap gap-2">
        <span class="tag px-3 py-1.5 rounded text-xs font-mono">Minecraft</span>
        <span class="tag px-3 py-1.5 rounded text-xs font-mono">YouTube</span>
        <span class="tag px-3 py-1.5 rounded text-xs font-mono">CTR</span>
        <span class="tag px-3 py-1.5 rounded text-xs font-mono">Photoshop</span>
      </div>
    </div>
  </div>
</section>
