---
const lang = Astro.url.pathname.includes("/es") ? "es" : "en";
const base = import.meta.env.BASE_URL;
---

<section id="about" class="section-alt py-28 px-5">
  <div class="max-w-6xl mx-auto grid md:grid-cols-[0.8fr_1.2fr] gap-16 items-center">
    <div>
      <p class="reveal font-mono text-[var(--color-accent)] text-sm mb-4 tracking-[0.3em] uppercase">// {lang === "es" ? "sobre mi" : "about"}</p>
      <h2 class="reveal tracking-tight leading-[0.95] mb-6" style="font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3.5rem);">
        {lang === "es"
          ? "Miniaturas que hacen crecer canales de Minecraft."
          : "Thumbnails that grow Minecraft channels."}
      </h2>
      <p class="reveal muted leading-relaxed text-lg mb-6" style="animation-delay:0.1s">
        {lang === "es"
          ? "Diseñé miniaturas para Chifruit y otros creadores de Minecraft. Sin click, no hay video — así que hago que la gente le dé click."
          : "I designed thumbnails for Chifruit and other Minecraft creators. No click, no video — so I make people click."}
      </p>
      <div class="reveal flex flex-wrap gap-2" style="animation-delay:0.2s">
        <span class="tag px-3 py-1.5 rounded text-xs font-mono">Minecraft</span>
        <span class="tag px-3 py-1.5 rounded text-xs font-mono">YouTube</span>
        <span class="tag px-3 py-1.5 rounded text-xs font-mono">CTR</span>
        <span class="tag px-3 py-1.5 rounded text-xs font-mono">Photoshop</span>
      </div>
    </div>

    <div class="mt-10 md:mt-0" data-parallax="0.04">
      <div class="reveal-scale bg-[var(--color-surface-dark)] border border-[var(--color-border-dark)] rounded-xl shadow-lg shadow-black/40 p-4">
        <div class="aspect-video flex items-center justify-center">
          <img src={`${base}thumbnails/miniatura de chifruit.jpg`} alt="Chifruit Minecraft thumbnail" class="max-w-full max-h-full object-contain drop-shadow-xl" />
        </div>
      </div>
    </div>
  </div>
</section>
