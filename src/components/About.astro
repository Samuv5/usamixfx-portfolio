---
const lang = Astro.url.pathname.includes("/es") ? "es" : "en";
const base = import.meta.env.BASE_URL;
---

<section id="about" class="section-alt">
  <div class="grid md:grid-cols-2">
    <div class="relative md:sticky md:top-0 md:h-screen overflow-hidden">
      <img src={`${base}thumbnails/miniatura de chifruit.jpg`} alt="Minecraft thumbnail" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-[var(--color-bg-dark)] opacity-10"></div>
    </div>

    <div class="px-5 md:px-16 py-24 md:py-40 flex flex-col justify-center gap-10">
      <p class="reveal font-mono text-[var(--color-accent)] text-sm tracking-[0.3em] uppercase">// {lang === "es" ? "sobre mi" : "about"}</p>
      <h2 class="reveal tracking-tight leading-[0.95]" style="font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3.5rem);">
        {lang === "es"
          ? "Miniaturas que hacen crecer canales de Minecraft."
          : "Thumbnails that grow Minecraft channels."}
      </h2>
      <p class="reveal muted leading-relaxed text-lg">
        {lang === "es"
          ? "Diseño miniaturas para creadores de Minecraft. Sin click, no hay video — así que hago que la gente le dé click."
          : "I design thumbnails for Minecraft creators. No click, no video — so I make people click."}
      </p>
      <div class="reveal flex flex-wrap gap-2">
        <span class="tag px-3 py-1.5 rounded text-xs font-mono">Minecraft</span>
        <span class="tag px-3 py-1.5 rounded text-xs font-mono">YouTube</span>
        <span class="tag px-3 py-1.5 rounded text-xs font-mono">CTR</span>
        <span class="tag px-3 py-1.5 rounded text-xs font-mono">Photoshop</span>
      </div>
    </div>
  </div>
</section>
