---
import { thumbnails } from "../data/thumbnails.js";

const lang = Astro.url.pathname.includes("/es") ? "es" : "en";
const base = import.meta.env.BASE_URL;
---

<section id="gallery" class="relative" style={`height: ${thumbnails.length * 100}vh`}>
  <div class="sticky top-0 h-screen flex flex-col justify-center px-5 overflow-hidden">
    <div class="max-w-6xl mx-auto w-full">
      <div class="flex items-end justify-between gap-4 mb-8">
        <h2 class="leading-none tracking-tight" style="font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 4.5rem);">
          {lang === "es" ? "Trabajos" : "Work"}
        </h2>
        <span class="font-mono text-sm muted mb-2"><span id="gallery-counter">01</span> / {String(thumbnails.length).padStart(2, '0')}</span>
      </div>

      <div class="relative aspect-video max-h-[60vh] mx-auto bg-[var(--color-surface-dark)] border border-[var(--color-border-dark)] rounded-xl shadow-lg shadow-black/40 flex items-center justify-center overflow-hidden">
        {thumbnails.map((thumb, i) => (
          <img
            src={`${base}${thumb.src}`}
            alt={thumb.alt}
            loading={i === 0 ? "eager" : "lazy"}
            class="gallery-slide absolute inset-0 w-full h-full object-contain p-4 transition-opacity duration-700 ease-out"
            data-slide={i}
            style={i === 0 ? "opacity:1" : "opacity:0"}
          />
        ))}
      </div>

      <div class="flex items-center justify-center gap-2 mt-6">
        {thumbnails.map((_, i) => (
          <div class="gallery-dot h-1 rounded-full bg-[var(--color-border-dark)] transition-all duration-500" style="width: 24px" data-dot={i}></div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function() {
  const section = document.getElementById('gallery');
  const slides = document.querySelectorAll('.gallery-slide');
  const dots = document.querySelectorAll('.gallery-dot');
  const counter = document.getElementById('gallery-counter');
  if (!section || !slides.length) return;

  let current = -1;
  function setActive(i) {
    if (i === current) return;
    current = i;
    slides.forEach((s) => s.style.opacity = Number(s.dataset.slide) === i ? "1" : "0");
    dots.forEach((d) => {
      const active = Number(d.dataset.dot) === i;
      d.style.background = active ? "var(--color-accent)" : "var(--color-border-dark)";
      d.style.width = active ? "40px" : "24px";
    });
    if (counter) counter.textContent = String(i + 1).padStart(2, '0');
  }

  let ticking = false;
  function update() {
    ticking = false;
    const rect = section.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
    const index = Math.min(slides.length - 1, Math.floor(progress * slides.length));
    setActive(index);
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }, { passive: true });

  setActive(0);
  update();
})();
</script>
