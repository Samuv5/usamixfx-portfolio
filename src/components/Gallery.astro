---
import WorkGrid from "./WorkGrid.astro";
import { thumbnails } from "../data/thumbnails.js";

const lang = Astro.url.pathname.includes("/es") ? "es" : "en";
const base = import.meta.env.BASE_URL;
const preview = thumbnails.slice(0, 3);
const workHref = lang === "es" ? `${base}es/work/` : `${base}work/`;
---

<section id="gallery" class="py-28 px-5">
  <div class="max-w-6xl mx-auto">
    <div class="reveal flex items-end justify-between gap-4 mb-16">
      <h2 class="leading-none tracking-tight" style="font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 4.5rem);">
        {lang === "es" ? "Trabajos" : "Work"}
      </h2>
      <a href={workHref} class="font-mono text-sm muted hover:text-[var(--color-accent)] transition uppercase tracking-widest mb-2">
        {lang === "es" ? `Ver los ${thumbnails.length} →` : `View all ${thumbnails.length} →`}
      </a>
    </div>

    <WorkGrid thumbnails={preview} />

    <p class="mt-8 font-mono text-sm muted text-center">
      {lang === "es" ? "// mas miniaturas en camino" : "// more thumbnails dropping soon"}
    </p>
  </div>
</section>
