---
const lang = Astro.url.pathname.includes("/es") ? "es" : "en";
const base = import.meta.env.BASE_URL;
---

<section class="min-h-[100svh] flex items-center relative overflow-hidden">
  <div class="absolute top-[5%] left-[5%]" data-parallax="0.08">
    <div class="glow glow-float w-[600px] h-[600px] bg-[var(--color-accent)] rounded-full blur-[220px] opacity-[0.08]"></div>
  </div>
  <div class="absolute top-1/3 right-[8%] w-2 h-2 rounded-full bg-[var(--color-accent)] opacity-60" data-parallax="0.3"></div>
  <div class="absolute bottom-1/4 left-[15%] w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] opacity-40" data-parallax="-0.2"></div>

  <div class="max-w-6xl mx-auto px-5 w-full pt-24">
    <div class="grid md:grid-cols-[1fr_auto] gap-12 items-end">
      <div>
        <p class="reveal is-visible font-mono text-[var(--color-accent)] text-sm mb-6 tracking-[0.3em] uppercase" style="animation-delay:0s">{lang === "es" ? "diseño de miniaturas" : "thumbnail design"}</p>
        <h1 class="reveal is-visible leading-[0.85] tracking-tight mb-8" style="animation-delay:0.1s; font-family: var(--font-display);">
          <span class="block text-[clamp(3.5rem,10vw,8rem)] font-medium">uSamix</span>
          <span class="block text-[clamp(3.5rem,10vw,8rem)] italic font-medium text-gradient">FX</span>
        </h1>
        <p class="reveal is-visible muted text-lg max-w-md leading-relaxed mb-10" style="animation-delay:0.2s">
          {lang === "es"
            ? "Miniaturas de Minecraft que llaman la atención y generan clicks. 100K+ vistas para canales de 200K+ subs."
            : "Minecraft thumbnails that grab attention and drive clicks. 100K+ views generated for 200K+ sub channels."}
        </p>
        <div class="reveal is-visible flex flex-wrap gap-3" style="animation-delay:0.3s">
          <a href="#gallery" class="btn-primary inline-flex items-center gap-2 px-6 py-3 bg-[var(--color-accent)] text-white font-semibold rounded-lg transition-all hover:brightness-110">
            {lang === "es" ? "Ver trabajos" : "View work"}
            <span class="text-lg">→</span>
          </a>
          <a href="https://discord.com/users/samuv5" target="_blank" class="btn-ghost inline-flex items-center gap-2 px-6 py-3 border border-[var(--color-border-dark)] rounded-lg font-medium transition-all hover:border-[var(--color-accent)]">
            Discord
          </a>
        </div>
      </div>
      <div class="hidden md:block" data-parallax="-0.06">
        <div class="reveal is-visible relative w-[32rem] aspect-video" style="animation-delay:0.2s">
          <img src={`${base}thumbnails/New Project (11).png`} alt="Thumbnail preview" class="w-full h-full object-cover rounded-lg shadow-2xl" />
          <div class="absolute -bottom-3 -right-3 w-full h-full border-2 border-[var(--color-accent)]/30 rounded-lg -z-10"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50">
    <span class="font-mono text-[10px] uppercase tracking-[0.3em]">scroll</span>
    <div class="w-px h-8 bg-current scroll-line"></div>
  </div>
</section>
