---
import { Image } from "astro:assets";
import { heroThumbnail } from "../data/thumbnails.js";

const lang = Astro.url.pathname.includes("/es") ? "es" : "en";
---

<section class="md:min-h-[100svh] grid md:grid-cols-2 relative overflow-hidden">
  <div class="flex flex-col justify-center px-5 md:px-12 pt-24 pb-8 md:py-32 relative z-10 order-2 md:order-1">
    <div class="absolute top-[10%] left-[-10%] -z-10" data-parallax="0.08">
      <div class="glow glow-float w-[500px] h-[500px] bg-[var(--color-accent)] rounded-full blur-[220px] opacity-[0.1]"></div>
    </div>

    <p class="reveal is-visible font-mono text-[var(--color-accent)] text-sm mb-4 md:mb-6 tracking-[0.3em] uppercase" style="animation-delay:0s">{lang === "es" ? "diseño de miniaturas" : "thumbnail design"}</p>
    <h1 class="reveal is-visible leading-[0.95] md:leading-[0.85] tracking-tight mb-4 md:mb-8" style="animation-delay:0.1s; font-family: var(--font-display);">
      <span class="block text-[clamp(2.5rem,12vw,6rem)] font-medium">uSamix</span>
      <span class="block text-[clamp(2.5rem,12vw,6rem)] italic font-medium text-gradient">FX</span>
    </h1>
    <p class="reveal is-visible muted text-base md:text-lg max-w-md leading-relaxed mb-6 md:mb-10" style="animation-delay:0.2s">
      {lang === "es"
        ? "Miniaturas de Minecraft que llaman la atención y generan clicks. 100K+ vistas para canales de 200K+ subs."
        : "Minecraft thumbnails that grab attention and drive clicks. 100K+ views generated for 200K+ sub channels."}
    </p>
    <div class="reveal is-visible flex flex-wrap gap-3" style="animation-delay:0.3s">
      <a href="#gallery" class="btn-primary inline-flex items-center gap-2 px-6 py-3 bg-[var(--color-accent)] text-white font-semibold rounded-lg transition-all hover:brightness-110">
        {lang === "es" ? "Ver trabajos" : "View work"}
        <span class="text-lg">→</span>
      </a>
      <a href="https://discord.com/users/samuv5" target="_blank" class="btn-ghost inline-flex items-center gap-2 px-6 py-3 border border-[var(--color-border-dark)] rounded-lg font-medium transition-all hover:border-[var(--color-accent)]">
        Discord
      </a>
    </div>
  </div>

  <div class="relative h-[26vh] md:h-auto overflow-hidden order-1 md:order-2 bg-[var(--color-bg-dark)]">
    <div class="absolute inset-0" data-parallax="-0.08">
      <Image src={heroThumbnail} alt="Thumbnail preview" width={1920} quality={90} loading="eager" class="w-full h-full object-cover scale-110" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg-dark)] from-5% via-[var(--color-bg-dark)]/40 via-45% to-transparent md:bg-gradient-to-l md:from-[var(--color-bg-dark)] md:from-0% md:via-[var(--color-bg-dark)]/30 md:via-40% md:to-transparent"></div>
  </div>

  <div class="hidden md:flex absolute bottom-6 left-1/2 -translate-x-1/2 flex-col items-center gap-2 opacity-50 z-20">
    <span class="font-mono text-[10px] uppercase tracking-[0.3em]">scroll</span>
    <div class="w-px h-8 bg-current scroll-line"></div>
  </div>
</section>
