---
const lang = Astro.url.pathname.includes("/es") ? "es" : "en";
---

<section id="contact" class="py-40 px-5 relative overflow-hidden">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[var(--color-accent)] rounded-full blur-[220px] opacity-[0.06] glow" data-parallax="0.05"></div>

  <div class="max-w-4xl mx-auto text-center relative">
    <p class="reveal font-mono text-[var(--color-accent)] text-sm mb-6 tracking-[0.3em] uppercase">// {lang === "es" ? "contacto" : "contact"}</p>
    <h2 class="reveal tracking-tight mb-8 leading-[0.95]" style="animation-delay:0.1s; font-family: var(--font-display); font-size: clamp(2.5rem, 7vw, 5.5rem);">
      {lang === "es"
        ? "Miniaturas que hacen crecer tu canal."
        : "Thumbnails that grow your channel."}
    </h2>
    <p class="reveal muted mb-10 leading-relaxed text-lg" style="animation-delay:0.2s">
      {lang === "es"
        ? "Escríbeme por Discord y arrancamos."
        : "Hit me up on Discord and let's get started."}
    </p>
    <a href="https://discord.com/users/samuv5" target="_blank" class="reveal btn-primary inline-flex items-center gap-3 px-8 py-4 bg-[var(--color-accent)] text-white font-semibold rounded-lg transition-all hover:brightness-110 group" style="animation-delay:0.3s">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03z"/></svg>
      <span>samuv5</span>
      <span class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </div>
</section>

<footer class="footer-bar py-8 px-5 border-t border-[var(--color-border-dark)]">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
    <span class="font-mono text-sm muted" style="font-family: var(--font-display);">uSamixFX</span>
    <span class="font-mono text-xs muted">© 2026</span>
  </div>
</footer>
