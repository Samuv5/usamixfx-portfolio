---
import Layout from "../../../layouts/Layout.astro";
import WorkGrid from "../../../components/WorkGrid.astro";
import { thumbnails } from "../../../data/thumbnails.js";

export async function getStaticPaths({ paginate }) {
  return paginate(thumbnails, { pageSize: 3 });
}

const { page } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={`uSamixFX — Trabajos (${page.currentPage}/${page.lastPage})`} description="Miniaturas de Minecraft por uSamixFX." lang="es">
  <section class="px-5 pt-32 pb-24">
    <div class="max-w-4xl mx-auto">
      <div class="reveal flex items-end justify-between gap-4 mb-12">
        <h1 class="leading-none tracking-tight" style="font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 4.5rem);">Trabajos</h1>
        <span class="font-mono text-sm muted mb-2">{page.start + 1}–{page.end + 1} / {page.total}</span>
      </div>

      <WorkGrid thumbnails={page.data} startIndex={page.start} />

      <div class="flex items-center justify-between mt-12 font-mono text-sm uppercase tracking-widest">
        {page.url.prev
          ? <a href={page.url.prev} class="hover:text-[var(--color-accent)] transition">← Anterior</a>
          : <span class="opacity-30">← Anterior</span>}
        <span class="muted">Página {page.currentPage} / {page.lastPage}</span>
        {page.url.next
          ? <a href={page.url.next} class="hover:text-[var(--color-accent)] transition">Siguiente →</a>
          : <span class="opacity-30">Siguiente →</span>}
      </div>

      <a href={`${base}es/`} class="inline-block mt-16 font-mono text-sm muted hover:text-[var(--color-accent)] transition">← Volver al inicio</a>
    </div>
  </section>
</Layout>
