---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Lightbox from "../components/Lightbox.astro";
import { thumbnails } from "../data/thumbnails.js";

const base = import.meta.env.BASE_URL;
const optimized = await Promise.all(
  thumbnails.map((thumb) => getImage({ src: thumb.image, width: 900 }))
);
---

<Layout title="uSamixFX — Full Gallery" description="All Minecraft thumbnails by uSamixFX." lang="en">
  <section class="px-5 pt-32 pb-24">
    <div class="max-w-5xl mx-auto">
      <a href={base} class="inline-flex items-center gap-2 font-mono text-sm muted hover:text-[var(--color-accent)] transition mb-12">
        ← Back to home
      </a>

      <div class="flex items-end justify-between gap-4 mb-12">
        <h1 class="leading-none tracking-tight" style="font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 4.5rem);">Full Gallery</h1>
        <span class="font-mono text-sm muted mb-2">{thumbnails.length} thumbnails</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {thumbnails.map((thumb, i) => (
          <div
            class="group relative overflow-hidden bg-[var(--color-surface-dark)] border border-[var(--color-border-dark)] rounded-xl shadow-lg shadow-black/40 cursor-pointer transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-[var(--color-accent)]/10 hover:border-[var(--color-accent)]/40"
            data-lightbox
            data-src={optimized[i].src}
            data-alt={thumb.alt}
          >
            <div class="aspect-video">
              <img
                src={optimized[i].src}
                alt={thumb.alt}
                loading="lazy"
                width={optimized[i].attributes.width}
                height={optimized[i].attributes.height}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <div class="absolute top-3 left-3">
              <span class="tag px-2 py-1 rounded text-[11px] font-mono font-medium bg-black/50 text-white backdrop-blur-sm">
                #{String(i + 1).padStart(2, '0')}
              </span>
            </div>
          </div>
        ))}
      </div>

      <a href={base} class="inline-flex items-center gap-2 font-mono text-sm muted hover:text-[var(--color-accent)] transition mt-16">
        ← Back to home
      </a>
    </div>
  </section>

  <Lightbox />
</Layout>
